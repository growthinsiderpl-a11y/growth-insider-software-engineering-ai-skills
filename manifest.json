  "tools": [
    {
      "id": "inventory-codebase",
      "path": "scripts/architecture/inventory_codebase.py",
      "domain": "architecture",
      "description": "Inventory a supplied codebase snapshot or local root into counts, extensions, and directory coverage."
    },
    {
      "id": "validate-dependency-direction",
      "path": "scripts/architecture/validate_dependency_direction.py",
      "domain": "architecture",
      "description": "Validate dependency edges against an explicit allowed layer graph."
    },
    {
      "id": "find-maintainability-violations",
      "path": "scripts/quality/find_maintainability_violations.py",
      "domain": "quality",
      "description": "Report observable maintainability findings such as oversized files, long lines, TODO markers, and debugger leftovers."
    },
    {
      "id": "generate-design-tokens",
      "path": "scripts/quality/generate_design_tokens.py",
      "domain": "quality",
      "description": "Generate deterministic design token structures and CSS custom properties from a supplied token set."
    },
    {
      "id": "validate-release-readiness",
      "path": "scripts/release/validate_release_readiness.py",
      "domain": "release",
      "description": "Validate explicit release evidence for tests, rollout, rollback, ownership, and observability."
    },
    {
      "id": "check-technical-seo-artifacts",
      "path": "scripts/seo/check_technical_seo_artifacts.py",
      "domain": "seo",
      "description": "Check supplied HTML for technical SEO artifacts such as metadata, headings, links, and structured data offline."
    }
